{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "types": ["node"], "strict": true,
    "noEmit": true, "esModuleInterop": true, "allowJs": true,
    "resolveJsonModule": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["api/**/*.ts", "server/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "admin-accounts.ts"]
}
