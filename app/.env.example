# SERVER ONLY. Do not use VITE_ prefixes for credentials. Never commit actual values.
# PostgreSQL is the only live academic-data source. Use the runtime login, not the owner.
DATABASE_URL=
DATABASE_SSL_CA=
PLANORA_TERM_KEY=fall-2026-main
# Production build is blocked until an operator explicitly approves a VERIFIED SQL cutover.
PLANORA_SQL_CUTOVER_APPROVED=false
# Local demonstration only, forbidden in production. Stores public fixtures in ignored app/.data/.
PLANORA_LOCAL_DB=false
# DATABASE_SSL=disable is permitted only for an isolated localhost test/dev PostgreSQL server.

# Existing fixed admin accounts; usernames/labels are in app/admin-accounts.ts.
PLANORA_ADMIN_AHMED_PASSWORD_HASH=
PLANORA_ADMIN_YOUSSEF_PASSWORD_HASH=
PLANORA_ADMIN_SESSION_SECRET=
# Private Redis remains for authentication rate limits, reports, feedback and legacy security history.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL + KV_REST_API_TOKEN are also supported by the existing integration.

# Optional existing assistant and report/security email integrations:
GEMINI_API_KEY=
PLANORA_REPORT_MAIL_WEBHOOK_URL=
PLANORA_REPORT_MAIL_WEBHOOK_SECRET=
PLANORA_SECURITY_MAIL_ENABLED=false

# Optional app -> fixed Ahmedamir21/Plan workflow dispatch. Fine-grained Actions-write credential.
PLANORA_SELF_SERVICE_ENABLED=false
PLANORA_GITHUB_ACTIONS_TOKEN=
PLANORA_SYNC_REF=
# University credentials belong ONLY to the separate protected Actions environment, not this web app.
# See sync/README.md and docs/SQL_SETUP.md. No VITE_ or browser storage credentials.

# Optional academic email: disabled | mock | resend-test | resend
PLANORA_EMAIL_MODE=disabled
PLANORA_EMAIL_TOKEN_SECRET=
PLANORA_EMAIL_FROM=
PLANORA_EMAIL_TEST_RECIPIENT=
PLANORA_PUBLIC_URL=
RESEND_API_KEY=
PLANORA_EMAIL_LIVE_APPROVED=false
